# Database (Desenvolvimento - PostgreSQL local via Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recicla_ai
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=5000
FLASK_ENV=development
FLASK_DEBUG=1

# Database Connection (usa o postgres do Docker Compose)
# Para produção, substitua pela URL do banco de produção
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/recicla_ai

