HOST=localhost

# Database (Desenvolvimento - PostgreSQL local via Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=recicla_ai
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=5000
FLASK_ENV=development
FLASK_DEBUG=1

# Database Connection (usa o postgres do Docker Compose)
# Para produção, substitua pela URL do banco de produção
DATABASE_URL=postgresql://postgres:password@localhost:5432/recicla_ai
